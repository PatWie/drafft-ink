# Settings of the Cloudflare Worker (web app and relay). Copy this file to `.env` and fill it in; `.env` is git-ignored.
# Plain KEY=value lines, no quotes, no spaces around `=` (the Makefile reads this file). Guide: docs/deploy-cloudflare.md.
#
# There are two environments on two Cloudflare accounts: demo (drafft.ink) and private (your own domain, behind
# Cloudflare Access). `make cf-dev` and `make cf-check-*` work with an empty `.env`. A deploy needs the values marked
# REQUIRED for its environment and says which one is missing.

# ---- How to run the tools ---------------------------------------------------------------------------------------

# wrangler runs inside apps/drafftink-worker, which pins wrangler 4 in package.json (`npm ci` installs it). Needs
# Node.js 22.12 or newer. Change this only to use another wrangler.
# WRANGLER=npx wrangler

# ---- Demo environment (drafft.ink) -------------------------------------------------------------------------------

# REQUIRED for a deploy. The id of the demo account: Cloudflare dashboard, Workers & Pages, right-hand column
# ("Account ID"), or the account's overview page, menu next to the account name, "Copy account ID".
DEMO_CLOUDFLARE_ACCOUNT_ID=

# Optional. Leave empty to use the login of `make cf-login` instead (one login at a time, so it fits one account).
# For CI or a machine without a browser: dashboard, My Profile, API Tokens, Create Token, "Edit Cloudflare Workers"
# template, with the permissions:
#   Account / Workers Scripts / Edit
#   Account / Account Settings / Read
#   User / User Details / Read, User / Memberships / Read
#   Zone / Workers Routes / Edit (only for the zone of DEMO_DOMAIN)
# Scope it to the demo account and that one zone. If the deploy fails on the custom domain, add Zone / DNS / Edit.
DEMO_CLOUDFLARE_API_TOKEN=

# The name of the Worker in the dashboard (Workers & Pages).
DEMO_WORKER_NAME=drafftink-relay-demo

# REQUIRED for a deploy. The hostname to serve on. Its zone (DNS) must be active on the demo account:
# dashboard, Domain Registration or Websites. Wrangler creates the DNS record and the certificate on the first deploy.
DEMO_DOMAIN=drafft.ink

# Seconds from the last visit until a room is deleted (172800 is 48 hours). Empty: rooms never expire.
DEMO_ROOM_TTL_SECS=172800

# Origins that may open a WebSocket from a browser, comma separated. Not set: https://<DEMO_DOMAIN>.
# DEMO_ALLOWED_ORIGINS=https://drafft.ink

# More limits (all optional, the defaults of render-config.sh apply when they are not set):
# DEMO_ROOM_LEAVE_GRACE_SECS=60
# DEMO_MAX_ROOM_STATE_BYTES=33554432
# DEMO_MAX_IMAGE_BYTES=4194304
# DEMO_MAX_ROOM_IMAGE_BYTES=52428800
# DEMO_MAX_ROOM_IMAGES=200

# ---- Private environment (your own domain, behind Cloudflare Access) -------------------------------------------

# REQUIRED for a deploy. The id of the private account (a different account than the demo): same places as above.
PRIVATE_CLOUDFLARE_ACCOUNT_ID=

# Optional, as the demo token, but created in the private account. Permissions:
#   Account / Workers Scripts / Edit
#   Account / Workers R2 Storage / Edit
#   Account / Account Settings / Read
#   User / User Details / Read, User / Memberships / Read
#   Zone / Workers Routes / Edit (only for the zone of PRIVATE_DOMAIN)
# Scope it to the private account and that one zone. If the deploy fails on the custom domain, add Zone / DNS / Edit.
PRIVATE_CLOUDFLARE_API_TOKEN=

# The name of the Worker in the dashboard.
PRIVATE_WORKER_NAME=drafftink-relay-private

# REQUIRED for a deploy. The hostname, for example canvas.example.com. Its zone must be active on the private account,
# and the hostname must have no DNS record yet (docs/design/collab-e2e.md, 19.3, step 1).
PRIVATE_DOMAIN=

# REQUIRED for a deploy. Your Zero Trust team domain, <team>.cloudflareaccess.com: the team name you chose in
# Zero Trust (19.3, step 4; shown under Settings) plus .cloudflareaccess.com. Write it without https://.
PRIVATE_ACCESS_TEAM_DOMAIN=

# REQUIRED for a deploy. The "Application Audience (AUD) Tag" of the Access application of PRIVATE_DOMAIN:
# Zero Trust, Access controls, Applications, your application, Edit, Additional settings (or the overview tab).
PRIVATE_ACCESS_AUD=

# The R2 bucket for pictures (19.3, step 3). Leave it private. Create it before the first deploy.
PRIVATE_R2_BUCKET=drafftink-private-blobs

# Seconds from the last visit until a room is deleted. Empty: rooms never expire (the private default).
PRIVATE_ROOM_TTL_SECS=

# Origins that may open a WebSocket from a browser, comma separated. Not set: https://<PRIVATE_DOMAIN>.
# PRIVATE_ALLOWED_ORIGINS=https://canvas.example.com

# More limits (all optional, the defaults of render-config.sh apply when they are not set):
# PRIVATE_ROOM_LEAVE_GRACE_SECS=60
# PRIVATE_MAX_ROOM_STATE_BYTES=268435456
# PRIVATE_MAX_IMAGE_BYTES=4194304
# PRIVATE_MAX_ROOM_IMAGE_BYTES=52428800
# PRIVATE_MAX_ROOM_IMAGES=200
# PRIVATE_ALLOW_DELETE_ROOM=true

# Not listed on purpose, because the defaults are right for each environment: BLOB_STORE (demo do, private r2) and
# ACCESS_REQUIRED (demo false, private true), both as DEMO_<NAME> and PRIVATE_<NAME>. See apps/drafftink-worker/README.md.
