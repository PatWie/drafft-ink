# Cloudflare deploy settings. Copy this file to `.env` and fill it in; `.env` is git-ignored.
# Plain KEY=value lines, no quotes, no spaces around `=` (the Makefile reads this file).

# Account id: Cloudflare dashboard, Workers & Pages, right-hand column ("Account ID").
CLOUDFLARE_ACCOUNT_ID=

# Optional. Leave empty and run `make cf-login` once to log in through the browser instead.
# For CI or a machine without a browser, create a token (My Profile, API Tokens) with:
#   Account / Workers Scripts / Edit, Zone / Workers Routes / Edit (for the zone of CF_DOMAIN).
CLOUDFLARE_API_TOKEN=

# The Worker that serves the web app. Its name shows in the dashboard.
CF_WORKER_NAME=drafftink-canvas

# The hostname to serve on. Its zone must be on this Cloudflare account; wrangler creates the DNS record.
CF_DOMAIN=canvas.patwie.com

# How to run wrangler. It needs Node.js 22.12 or newer.
WRANGLER=npx --yes wrangler@4
