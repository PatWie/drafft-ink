{
  "about": "A selection becomes a library item, the item is inserted back as new elements with new ids (one undo step), renamed and removed; refusals say what to do. Library edits are not document history.",
  "steps": [
    { "assert": "library.list", "expect": [ { "path": "$.items", "len": 0 } ] },
    { "execute": "library.add", "refused": "no_target", "text": "Nothing to act on: no elements are selected. Select elements first, or pass `ids`." },
    { "execute": "element.create", "args": { "kind": "rectangle", "bounds": { "x": 100, "y": 100, "w": 100, "h": 60 } } },
    { "execute": "element.relabel", "args": { "id": "e1", "text": "Start" } },
    { "execute": "element.create", "args": { "kind": "ellipse", "bounds": { "x": 300, "y": 100, "w": 100, "h": 60 } } },
    { "assert": "history.state", "save": { "depth": "$.undo_depth" } },

    { "execute": "library.add", "args": { "ids": ["e1", "e3"], "name": "Pair" }, "expect": [
        { "path": "$.item.name", "eq": "Pair" }, { "path": "$.item.element_count", "eq": 3, "note": "The rectangle, its label and the ellipse." },
        { "path": "$.item.bounds", "eq": [0, 0, 300, 60], "note": "Moved so that its top-left corner is at 0, 0." } ], "save": { "pair": "$.item.id" } },
    { "execute": "library.add", "args": { "ids": ["e1"], "name": "   " }, "refused": "empty_name", "text": "The name is empty. Give a name of 1 to 256 characters." },
    { "execute": "library.add", "args": { "ids": ["e3"] }, "expect": [ { "path": "$.item.name", "eq": null } ] },
    { "assert": "library.list", "expect": [ { "path": "$.items", "len": 2 } ] },
    { "assert": "library.list", "args": { "search": "PAIR" }, "expect": [ { "path": "$.items", "len": 1, "note": "The search ignores case." }, { "path": "$.items[0].id", "eq": "{{pair}}" } ] },
    { "assert": "history.state", "expect": [ { "path": "$.undo_depth", "eq": "{{depth}}", "note": "Adding to the library is not a document step." } ] },
    { "assert": "library.thumbnail", "args": { "item": "{{pair}}", "max_side": 128 }, "expect": [
        { "path": "$.width", "eq": 128, "note": "The item is 300 by 60 units with 15 units of air around it: 330 by 90, drawn 128 pixels wide." },
        { "path": "$.height", "eq": 35 }, { "path": "$.item", "eq": "{{pair}}" }, { "path": "$.bytes.mime", "eq": "image/png" } ] },
    { "assert": "history.state", "expect": [ { "path": "$.undo_depth", "eq": "{{depth}}", "note": "Drawing an item changes nothing." } ] },
    { "execute": "library.thumbnail", "args": { "item": "Pair", "max_side": 8 }, "refused": "bad_args", "text": "max_side" },
    { "execute": "library.thumbnail", "args": { "item": "nope" }, "refused": "no_such_item", "text": "There is no library item `nope`." },

    { "execute": "library.insert", "args": { "item": "Pair", "at": [1000, 500] }, "expect": [ { "path": "$.ids", "len": 3 }, { "path": "$.item", "eq": "{{pair}}" }, { "path": "$.undo_label", "eq": "Insert from library" } ] },
    { "assert": "doc.inspect", "expect": [ { "path": "$.elements", "eq": 4 }, { "path": "$.labels", "eq": 2 }, { "path": "$.bounds.w", "gt": 900, "note": "The copy is centred on the point, far from the original." } ] },
    { "assert": "selection.get", "expect": [ { "path": "$.count", "eq": 3, "note": "The inserted elements are selected, the label with its rectangle." } ] },
    { "undo": 1 },
    { "assert": "doc.inspect", "expect": [ { "path": "$.elements", "eq": 2, "note": "The insertion is one undo step." } ] },
    { "execute": "library.insert", "args": { "item": "nope" }, "refused": "no_such_item", "text": "There is no library item `nope`. List items with `library.list`." },

    { "execute": "library.rename", "args": { "item": "Pair", "name": "Two shapes" }, "expect": [ { "path": "$.item.name", "eq": "Two shapes" } ] },
    { "execute": "library.rename", "args": { "item": "Two shapes", "name": "Two shapes" }, "expect": [ { "path": "$.changed", "eq": false, "note": "The same name is Ok." } ] },
    { "execute": "library.rename", "args": { "item": "Two shapes", "name": "" }, "refused": "empty_name", "text": "The name is empty." },
    { "execute": "library.rename", "args": { "item": "nope", "name": "x" }, "refused": "no_such_item" },

    { "execute": "library.remove", "refused": "bad_args", "text": "Give either `items` or all=true." },
    { "execute": "library.remove", "args": { "items": ["nope"] }, "refused": "no_such_item", "text": "There is no library item `nope`." },
    { "execute": "library.remove", "args": { "items": ["Two shapes"] }, "expect": [ { "path": "$.removed", "eq": ["{{pair}}"] } ] },
    { "assert": "library.list", "expect": [ { "path": "$.items", "len": 1 } ] },
    { "execute": "library.remove", "args": { "all": true }, "expect": [ { "path": "$.removed", "len": 1 } ] },
    { "assert": "library.list", "expect": [ { "path": "$.items", "len": 0 } ] },
    { "undo": 1, "expect": [ { "path": "$.undone", "len": 1, "note": "Removal is not undoable, and undo still reaches the last document step." } ] }
  ]
}
