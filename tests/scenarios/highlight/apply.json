{
  "about": "highlight.apply puts a marker band behind elements and behind character ranges of texts in one undo step, takes it off with no colour, refuses what it cannot do without changing anything, and the same property is reachable through style.set.",
  "steps": [
    { "execute": "element.create", "args": { "kind": "rectangle", "bounds": { "x": 0, "y": 0, "w": 100, "h": 60 } }, "save": { "box": "$.id" } },
    { "execute": "element.create", "args": { "kind": "text", "text": "héllo wörld", "at": [0, 200] }, "save": { "words": "$.id" } },
    { "execute": "element.create", "args": { "kind": "frame", "bounds": { "x": 400, "y": 0, "w": 200, "h": 200 }, "capture": false }, "save": { "frame": "$.id" } },

    { "execute": "highlight.apply", "args": { "color": "yellow", "ids": ["{{box}}", "{{frame}}"], "ranges": [ { "id": "{{words}}", "start": 6, "end": 11 } ] }, "expect": [
        { "path": "$.changed", "eq": true },
        { "path": "$.highlighted", "eq": ["{{box}}", "{{words}}"] },
        { "path": "$.skipped", "eq": ["{{frame}}"], "note": "a frame is a container and takes no band" },
        { "path": "$.undo_label", "eq": "Highlight" } ] },
    { "assert": "style.get", "args": { "ids": ["{{box}}"], "props": ["highlight"] }, "expect": [ { "path": "$.props.highlight.value", "eq": "yellow-400" } ] },
    { "assert": "element.query", "args": { "filter": { "ids": ["{{words}}"] }, "fields": ["runs"] }, "expect": [
        { "path": "$.items[0].runs[0].start", "eq": 6 }, { "path": "$.items[0].runs[0].end", "eq": 11, "note": "characters, not bytes: the ö is one" },
        { "path": "$.items[0].runs[0].highlight", "eq": "yellow-400" } ] },

    { "execute": "highlight.apply", "args": { "color": "yellow", "ids": ["{{box}}"] }, "expect": [ { "path": "$.changed", "eq": false }, { "path": "$.unchanged", "eq": ["{{box}}"] } ] },

    { "execute": "highlight.apply", "args": { "color": "yellow", "ranges": [ { "id": "{{words}}", "start": 3, "end": 99 } ] }, "refused": "bad_range", "text": "outside the text" },
    { "execute": "highlight.apply", "args": { "color": "yellow", "ranges": [ { "id": "{{box}}", "start": 0, "end": 1 } ] }, "refused": "wrong_kind" },
    { "execute": "highlight.apply", "args": { "color": "yellow", "ids": ["{{frame}}"] }, "refused": "not_applicable" },
    { "execute": "highlight.apply", "args": { "color": "mauve", "ids": ["{{box}}"] }, "refused": "bad_args", "text": "mauve" },
    { "execute": "highlight.apply", "args": { "color": "pink", "ids": ["{{box}}", "zzz"] }, "refused": "not_found" },
    { "assert": "style.get", "args": { "ids": ["{{box}}"], "props": ["highlight"] }, "expect": [ { "path": "$.props.highlight.value", "eq": "yellow-400", "note": "a refused call changed nothing" } ] },

    { "execute": "highlight.apply", "args": { "ids": ["{{box}}"] }, "expect": [ { "path": "$.highlighted", "eq": ["{{box}}"] } ] },
    { "assert": "style.get", "args": { "ids": ["{{box}}"], "props": ["highlight"] }, "expect": [ { "path": "$.props.highlight.value", "eq": null } ] },

    { "execute": "style.set", "args": { "ids": ["{{box}}"], "props": { "highlight": "green" }, "scope": "selection" }, "expect": [ { "path": "$.applied.e1", "eq": ["highlight"], "note": "the rectangle is the first element made: e1" } ] },
    { "execute": "style.set", "args": { "ids": ["{{frame}}"], "props": { "highlight": "green" }, "scope": "selection" }, "refused": "not_applicable" },

    { "undo": 2, "expect": [ { "path": "$.undone", "eq": ["Set style", "Highlight"] } ] },
    { "assert": "style.get", "args": { "ids": ["{{box}}"], "props": ["highlight"] }, "expect": [ { "path": "$.props.highlight.value", "eq": "yellow-400", "note": "undo brought the band back to what the first call made" } ] },
    { "undo": 1 },
    { "assert": "style.get", "args": { "ids": ["{{box}}"], "props": ["highlight"] }, "expect": [ { "path": "$.props.highlight.value", "eq": null } ] },
    { "assert": "element.query", "args": { "filter": { "ids": ["{{words}}"] }, "fields": ["runs"] }, "expect": [ { "path": "$.items[0].runs", "len": 0, "note": "one undo step took back the element and the range together" } ] }
  ]
}
