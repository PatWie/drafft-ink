{
  "about": "View-only mode keeps the camera working, refuses edits with the way out in the message, and leaves when asked.",
  "steps": [
    { "harness": "load_generated", "args": { "count": 6 } },
    { "execute": "view.set_view_only", "args": { "on": true }, "expect": [ { "path": "$.view_only", "eq": true } ] },
    { "assert": "view.get", "expect": [ { "path": "$.view_only", "eq": true } ] },
    { "execute": "view.zoom_in", "expect": [ { "path": "$.changed", "eq": true } ] },
    { "execute": "style.set", "args": { "ids": ["e0"], "props": { "stroke_width": 4 } }, "refused": "view_only", "text": ["view-only", "view.set_view_only"] },
    { "assert": "history.state", "expect": [ { "path": "$.can_undo", "eq": false } ], "note": "The refused edit left no undo step." },
    { "execute": "view.set_view_only", "args": { "on": false } },
    { "execute": "style.set", "args": { "ids": ["e0"], "props": { "stroke_width": 4 } }, "expect": [ { "path": "$.changed", "eq": true } ] },
    { "undo": 1, "expect": [ { "path": "$.undone[0]", "eq": "Set style" } ] }
  ]
}
