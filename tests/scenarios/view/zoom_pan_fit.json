{
  "about": "Zoom, pan and fit move only the camera: they act at once, add no undo step, and a bad value is refused in words.",
  "steps": [
    { "harness": "load_generated", "args": { "count": 12 } },
    { "execute": "view.set_viewport", "args": { "width": 1000, "height": 800, "scale_factor": 1 }, "expect": [ { "path": "$.changed", "eq": true } ] },
    { "assert": "view.get", "expect": [ { "path": "$.percent", "near": 100, "tol": 1e-9 }, { "path": "$.viewport.w", "eq": 1000 } ], "save": { "z0": "$.zoom" } },

    { "note": "docs/commands.md: view.zoom_in multiplies the zoom by 1.25; zoom_out undoes it.", "execute": "view.zoom_in", "expect": [ { "path": "$.zoom", "near": "{{z0}}", "plus": 0.42, "tol": 1e-9 } ] },
    { "execute": "view.zoom_out", "expect": [ { "path": "$.zoom", "near": "{{z0}}", "tol": 1e-9 } ] },

    { "execute": "view.set", "args": { "zoom": 1, "scroll": [10, 20] }, "expect": [ { "path": "$.scroll", "near": [10, 20] } ] },
    { "note": "dx and dy are screen pixels and the content follows the pointer, so at zoom 1 the scroll centre moves the other way.",
      "execute": "view.pan", "args": { "dx": 100, "dy": 0 }, "expect": [ { "path": "$.scroll", "near": [-90, 20] } ] },

    { "assert": "doc.inspect", "save": { "bx": "$.bounds.x", "by": "$.bounds.y", "bw": "$.bounds.w", "bh": "$.bounds.h" } },
    { "execute": "view.zoom_to_fit", "args": { "padding": 50 } },
    { "assert": "view.get", "expect": [
        { "path": "$.visible.x", "le": "{{bx}}" }, { "path": "$.visible.y", "le": "{{by}}" },
        { "path": "$.visible.w", "ge": "{{bw}}" }, { "path": "$.visible.h", "ge": "{{bh}}" } ],
      "note": "After a fit the visible world rectangle covers the whole content." },

    { "execute": "view.set", "args": { "zoom": "big" }, "refused": "bad_args", "text": "zoom" },
    { "execute": "view.set", "args": { "zoom": 100000 }, "expect": [ { "path": "$.zoom", "eq": 30 } ], "note": "Zoom is clamped to 0.1 .. 30, not refused." },

    { "note": "The camera is not part of the document history.", "undo": 1, "refused": "nothing_to_undo", "text": "nothing to undo" },
    { "assert": "history.state", "expect": [ { "path": "$.can_undo", "eq": false } ] }
  ]
}
