{
  "about": "Arrow type, heads and re-routing change the arrow and keep its bindings; a rectangle is refused with the kinds that work.",
  "steps": [
    { "harness": "load_generated", "args": { "count": 5 } },
    { "execute": "arrow.reroute", "args": { "ids": ["e4"] }, "expect": [ { "path": "$.rerouted", "eq": ["e4"] } ] },
    { "harness": "scene_probe", "args": { "id": "e4" }, "save": { "n0": "$.element.points" }, "expect": [ { "path": "$.element.points", "len": 2, "note": "a straight arrow has two points" } ] },

    { "execute": "arrow.set_type", "args": { "ids": ["e4"], "type": "elbow" }, "expect": [ { "path": "$.undo_label", "eq": "Set arrow type" } ] },
    { "harness": "scene_probe", "args": { "id": "e4" }, "expect": [
        { "path": "$.element.points", "len": 4, "note": "an elbow arrow turns twice" },
        { "path": "$.element.binding.start.target", "eq": "e0" }, { "path": "$.element.binding.end.target", "eq": "e1" } ] },

    { "execute": "arrow.set_head", "args": { "ids": ["e4"], "end": "start", "head": "triangle" }, "expect": [ { "path": "$.changed", "eq": true } ] },
    { "execute": "arrow.swap_heads", "args": { "ids": ["e4"] }, "expect": [ { "path": "$.undo_label", "eq": "Swap arrowheads" } ] },

    { "execute": "arrow.set_type", "args": { "ids": ["e4"], "type": "zigzag" }, "refused": "bad_args", "text": "zigzag" },
    { "execute": "arrow.set_type", "args": { "ids": ["e0"], "type": "elbow" }, "refused": "not_applicable", "text": "arrows and lines" },

    { "undo": 3, "expect": [ { "path": "$.undone", "len": 3 } ] },
    { "harness": "scene_probe", "args": { "id": "e4" }, "expect": [ { "path": "$.element.points", "len": 2, "note": "Back to the straight arrow." } ] }
  ]
}
