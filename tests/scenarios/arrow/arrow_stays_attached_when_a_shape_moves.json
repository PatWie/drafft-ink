{
  "about": "Headline feature: an arrow bound to a shape follows it when the shape moves and goes back when the move is undone.",
  "steps": [
    { "note": "e0 rectangle, e1 ellipse, e4 arrow from e0 to e1. Re-route first so the arrow sits at its resting gap from both shapes.",
      "harness": "load_generated", "args": { "count": 5 } },
    { "execute": "arrow.reroute", "args": { "ids": ["e4"] } },
    { "assert": "element.query", "args": { "filter": { "ids": ["e4"] }, "fields": ["points"] }, "save": { "x0": "$.items[0].points[0][0]", "y0": "$.items[0].points[0][1]", "x1": "$.items[0].points[1][0]", "y1": "$.items[0].points[1][1]" } },
    { "assert": "element.query", "args": { "filter": { "ids": ["e0"] }, "fields": ["bounds"] }, "save": { "rx": "$.items[0].bounds.x" } },

    { "note": "Move the rectangle (the arrow's start) 60 left and 40 down, away from the ellipse (a move to the right would push it over the ellipse, and the arrow has only 27 units of room).",
      "execute": "element.move", "args": { "ids": ["e0"], "dx": -60, "dy": 40, "snap": "none" } },
    { "assert": "element.query", "args": { "filter": { "ids": ["e0"] }, "fields": ["bounds"] }, "expect": [ { "path": "$.items[0].bounds.x", "near": "{{rx}}", "plus": -60, "tol": 0.01 } ] },
    { "assert": "element.query", "args": { "filter": { "ids": ["e4"] }, "fields": ["points", "bindings"] }, "expect": [
        { "path": "$.items[0].bindings.start", "eq": "e0", "note": "still bound" },
        { "path": "$.items[0].bindings.end", "eq": "e1" },
        { "path": "$.items[0].points[0][0]", "near": "{{x0}}", "plus": -60, "tol": 1.0, "note": "the start followed the rectangle" },
        { "path": "$.items[0].points[0][1]", "near": "{{y0}}", "plus": 40, "tol": 4.0, "note": "the start follows 40 down. The orbit point also turns a little as the line to the fixed end tilts (2.6 here), so the tolerance is 4, not the 1 of x" },
        { "path": "$.items[0].points[1][0]", "near": "{{x1}}", "tol": 1.0, "note": "the end stayed on the ellipse" },
        { "path": "$.items[0].points[1][1]", "near": "{{y1}}", "tol": 4.0, "note": "y may slide along the ellipse outline by about 2.6 as the line tilts; x does not" } ] },

    { "undo": 1 },
    { "assert": "element.query", "args": { "filter": { "ids": ["e4"] }, "fields": ["points", "bindings"] }, "expect": [
        { "path": "$.items[0].points[0][0]", "near": "{{x0}}", "tol": 0.01 }, { "path": "$.items[0].points[0][1]", "near": "{{y0}}", "tol": 0.01 },
        { "path": "$.items[0].points[1][0]", "near": "{{x1}}", "tol": 0.01 }, { "path": "$.items[0].points[1][1]", "near": "{{y1}}", "tol": 0.01 } ] },

    { "note": "Moving the ellipse (the end) drags the other end of the arrow.",
      "execute": "element.move", "args": { "ids": ["e1"], "dx": 0, "dy": 80, "snap": "none" } },
    { "assert": "element.query", "args": { "filter": { "ids": ["e4"] }, "fields": ["points", "bindings"] }, "expect": [
        { "path": "$.items[0].points[0][0]", "near": "{{x0}}", "tol": 1.0, "note": "the start stayed" },
        { "path": "$.items[0].points[1][1]", "gt": "{{y1}}", "note": "the end moved down with the ellipse" } ] }
  ]
}
