{
  "about": "Deleting the shape an arrow end is bound to leaves the arrow where it was and frees that end; undo restores shape and binding.",
  "steps": [
    { "harness": "load_generated", "args": { "count": 5 } },
    { "execute": "arrow.reroute", "args": { "ids": ["e4"] } },
    { "assert": "element.query", "args": { "filter": { "ids": ["e4"] }, "fields": ["points"] }, "save": { "x0": "$.items[0].points[0][0]", "y0": "$.items[0].points[0][1]" } },
    { "execute": "element.delete", "args": { "ids": ["e0"] }, "expect": [ { "path": "$.deleted", "eq": ["e0"] } ] },
    { "assert": "element.query", "args": { "filter": { "ids": ["e4"] }, "fields": ["points", "bindings"] }, "expect": [
        { "path": "$.items[0].bindings.start", "eq": null }, { "path": "$.items[0].bindings.end", "eq": "e1" },
        { "path": "$.items[0].points[0][0]", "near": "{{x0}}", "tol": 0.01 }, { "path": "$.items[0].points[0][1]", "near": "{{y0}}", "tol": 0.01 } ] },
    { "undo": 1 },
    { "assert": "element.query", "args": { "filter": { "ids": ["e4"] }, "fields": ["bindings"] }, "expect": [ { "path": "$.items[0].bindings.start", "eq": "e0" } ] },
    { "assert": "doc.inspect", "expect": [ { "path": "$.elements", "eq": 5 } ] }
  ]
}
