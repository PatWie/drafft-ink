{
  "about": "Deleting the shape an arrow end is bound to leaves the arrow where it was and frees that end; undo restores shape and binding.",
  "requires": { "commands": ["element.delete"] },
  "steps": [
    { "harness": "load_generated", "args": { "count": 5 } },
    { "execute": "arrow.reroute", "args": { "ids": ["e4"] } },
    { "harness": "scene_probe", "args": { "id": "e4" }, "save": { "x0": "$.element.points[0][0]", "y0": "$.element.points[0][1]" } },
    { "execute": "element.delete", "args": { "ids": ["e0"] }, "expect": [ { "path": "$.deleted", "eq": ["e0"] } ] },
    { "harness": "scene_probe", "args": { "id": "e4" }, "expect": [
        { "path": "$.element.binding.start", "eq": null }, { "path": "$.element.binding.end.target", "eq": "e1" },
        { "path": "$.element.points[0][0]", "near": "{{x0}}", "tol": 0.01 }, { "path": "$.element.points[0][1]", "near": "{{y0}}", "tol": 0.01 } ] },
    { "undo": 1 },
    { "harness": "scene_probe", "args": { "id": "e4" }, "expect": [ { "path": "$.element.binding.start.target", "eq": "e0" }, { "path": "$.total", "eq": 5 } ] }
  ]
}
