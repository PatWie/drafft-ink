{
  "about": "Images are inserted from inline bytes: a small picture keeps its size, a large one is scaled to the fit width, several pictures cascade, and bad bytes are refused with the supported formats. One undo removes the whole insert.",
  "steps": [
    { "execute": "image.insert", "args": { "images": [ { "base64": "iVBORw0KGgoAAAANSUhEUgAAACgAAAAUCAIAAABwJOjsAAAAJElEQVR4nGM4YWQ0IIhh1OJRi0ctHrV41OJRi0ctHrV45FgMAAkCqa66Bn33AAAAAElFTkSuQmCC", "name": "small.png" } ], "at": [100, 100] },
      "expect": [ { "path": "$.created", "len": 1 } ], "save": { "small": "$.created[0]" } },
    { "assert": "element.query", "args": { "filter": { "kind": "image" }, "fields": ["id", "kind", "bounds"] }, "expect": [
        { "path": "$.total", "eq": 1 }, { "path": "$.items[0].bounds.w", "eq": 40 }, { "path": "$.items[0].bounds.h", "eq": 20 },
        { "path": "$.items[0].bounds.x", "eq": 80, "note": "Centred on (100, 100): 100 - 40 / 2." } ] },
    { "assert": "selection.get", "expect": [ { "path": "$.ids", "eq": ["{{small}}"] } ] },

    { "execute": "image.insert", "args": { "images": [ { "base64": "", "name": "wide.png" } ], "at": [0, 500], "fit": 400 },
      "save": { "wide": "$.created[0]" } },
    { "assert": "element.query", "args": { "filter": { "ids": ["{{wide}}"] }, "fields": ["bounds"] }, "expect": [ { "path": "$.items[0].bounds.w", "eq": 400 }, { "path": "$.items[0].bounds.h", "eq": 200, "note": "2000 x 1000 scaled to a longest side of 400 keeps the ratio." } ] },

    { "execute": "image.insert", "args": { "images": [ { "base64": "iVBORw0KGgoAAAANSUhEUgAAACgAAAAUCAIAAABwJOjsAAAAJElEQVR4nGM4YWQ0IIhh1OJRi0ctHrV41OJRi0ctHrV45FgMAAkCqa66Bn33AAAAAElFTkSuQmCC" }, { "base64": "" } ], "at": [0, 900], "offset": 30 }, "expect": [ { "path": "$.created", "len": 2 } ] },
    { "assert": "element.query", "args": { "filter": { "kind": "image" }, "fields": ["id", "bounds"] }, "expect": [ { "path": "$.total", "eq": 4 } ] },
    { "undo": 1 },
    { "assert": "element.query", "args": { "filter": { "kind": "image" }, "fields": ["id"] }, "expect": [ { "path": "$.total", "eq": 2 } ], "note": "The two pictures of one insert go in one undo step." },

    { "execute": "image.insert", "args": { "images": [ { "base64": "bm90IGFuIGltYWdl", "name": "notes.txt" } ] }, "refused": "unsupported_format", "text": ["`notes.txt` is not a supported image", "PNG, JPEG, WebP, GIF, BMP, ICO or SVG"] },
    { "execute": "image.insert", "args": { "images": [] }, "refused": "bad_args" },
    { "assert": "element.query", "args": { "filter": { "kind": "image" } }, "expect": [ { "path": "$.total", "eq": 2 }, { "path": "$.items", "len": 2 } ], "note": "Refusals change nothing." },
    { "execute": "element.create", "args": { "kind": "image" }, "refused": "wrong_kind", "text": "Use `image.insert`" }
  ]
}
