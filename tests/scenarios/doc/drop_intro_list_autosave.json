{
  "about": "The rest of the doc family: doc.drop routes dropped files by content (a document opens in a tab, a library is imported, other files are refused), doc.show_intro loads the built-in welcome document, doc.list shows the recent and stored documents, and doc.autosave writes the workspace through the Storage port.",
  "steps": [
    { "harness": "stage_fixture", "args": { "path": "excalidraw/basic_shapes.excalidraw" } },
    { "harness": "stage_fixture", "args": { "path": "excalidraw/fixture_library.excalidrawlib" } },

    { "execute": "doc.drop", "args": { "items": [] }, "refused": "nothing_to_do", "text": "Nothing to open: none of the 0 dropped files is an image, document or library. Supported: PNG, JPEG, WebP, .json, .drafftink, .excalidraw, .excalidrawlib." },
    { "execute": "doc.drop", "args": { "items": [ { "name": "notes.txt", "bytes": { "base64": "aGVsbG8=" } } ] }, "refused": "nothing_to_do", "text": "none of the 1 dropped files is an image, document or library" },
    { "execute": "doc.drop", "args": { "items": [ { "name": "shapes.excalidraw", "bytes": { "path": "fixtures/excalidraw/basic_shapes.excalidraw" } } ] }, "expect": [ { "path": "$.documents", "eq": 1 }, { "path": "$.images", "eq": 0 } ] },
    { "assert": "tab.list", "expect": [ { "path": "$.tabs", "len": 2, "note": "documents=new_tab is the default for a drop." } ] },
    { "assert": "doc.inspect", "expect": [ { "path": "$.elements", "eq": 17 } ] },
    { "execute": "doc.drop", "args": { "items": [ { "name": "lib.excalidrawlib", "bytes": { "path": "fixtures/excalidraw/fixture_library.excalidrawlib" } } ] }, "expect": [ { "path": "$.library_items", "eq": 1 }, { "path": "$.documents", "eq": 0 } ] },
    { "assert": "library.list", "expect": [ { "path": "$.items", "len": 1 } ] },

    { "execute": "doc.show_intro", "args": { "mode": "new_tab" }, "expect": [ { "path": "$.format", "eq": "intro" }, { "path": "$.name", "eq": "Welcome" }, { "path": "$.elements", "eq": 35 } ] },
    { "assert": "history.state", "expect": [ { "path": "$.can_undo", "eq": false } ] },
    { "execute": "element.create", "args": { "kind": "rectangle", "bounds": { "x": 0, "y": 0, "w": 100, "h": 60 } } },
    { "execute": "doc.show_intro", "refused": "unsaved_changes", "text": "This document has unsaved changes. Save it with `doc.save`" },
    { "execute": "doc.show_intro", "args": { "on_unsaved": "discard" }, "expect": [ { "path": "$.mode", "eq": "replace" }, { "path": "$.elements", "eq": 35 } ] },

    { "assert": "doc.list", "expect": [ { "path": "$.documents", "len": 1, "note": "Only the dropped file that was opened is recent so far." }, { "path": "$.documents[0].name", "eq": "basic_shapes.excalidraw" } ] },
    { "execute": "doc.save", "args": { "to": { "path": "work/welcome.drafftink" } } },
    { "assert": "doc.list", "expect": [ { "path": "$.documents", "len": 2 }, { "path": "$.documents[0].ref.path", "eq": "work/welcome.drafftink", "note": "The newest is first." } ] },
    { "execute": "doc.save", "args": { "to": { "stored": "plan" } } },
    { "assert": "doc.list", "args": { "from": "stored" }, "expect": [ { "path": "$.documents", "len": 1 }, { "path": "$.documents[0].ref.stored", "eq": "plan" } ] },
    { "assert": "doc.list", "args": { "from": "autosave" }, "expect": [ { "path": "$.documents", "len": 0 } ] },
    { "execute": "doc.autosave", "expect": [ { "path": "$.saved", "eq": true }, { "path": "$.tabs", "eq": 3 } ] },
    { "assert": "doc.list", "args": { "from": "autosave" }, "expect": [ { "path": "$.documents[0].ref.stored", "eq": "autosave" } ] },
    { "execute": "doc.autosave", "expect": [ { "path": "$.saved", "eq": false, "note": "Nothing changed since the last write." } ] },
    { "assert": "history.state", "expect": [ { "path": "$.undo_depth", "eq": 0, "note": "None of this added an undo step." } ] }
  ]
}
