{
  "about": "The document's own properties: doc.new starts a blank document (and refuses to drop unsaved work unless told), doc.rename and doc.set_background are undoable edits, and doc.clear removes everything including locked elements in one undo step.",
  "steps": [
    { "execute": "doc.clear", "refused": "empty_document", "text": "The document is already empty, so there is nothing to clear." },
    { "execute": "doc.rename", "args": { "name": "  Plan  " }, "expect": [ { "path": "$.name", "eq": "Plan", "note": "The name is trimmed." }, { "path": "$.undo_label", "eq": "Rename document" } ] },
    { "execute": "doc.rename", "args": { "name": "Plan" }, "expect": [ { "path": "$.changed", "eq": false, "note": "The same name is Ok and changes nothing." } ] },
    { "execute": "doc.rename", "args": { "name": "   " }, "refused": "empty_name", "text": "The name is empty. Give a name of 1 to 120 characters." },
    { "undo": 1 },
    { "assert": "doc.inspect", "expect": [ { "path": "$.name", "eq": "Untitled", "note": "Undo takes the name back." } ] },

    { "execute": "doc.set_background", "args": { "color": "#fafafa" }, "expect": [ { "path": "$.background", "eq": "#fafafa" }, { "path": "$.undo_label", "eq": "Set background colour" } ] },
    { "execute": "doc.set_background", "args": { "color": "#fafafa" }, "expect": [ { "path": "$.changed", "eq": false } ] },
    { "execute": "doc.set_background", "args": { "color": "transparent" }, "expect": [ { "path": "$.background", "eq": "#00000000" } ] },
    { "execute": "doc.set_background", "args": { "color": "not-a-colour" }, "refused": "bad_args", "text": "color" },
    { "undo": 2 },
    { "assert": "doc.inspect", "expect": [ { "path": "$.background", "eq": "#ffffff" } ] },

    { "execute": "element.create", "args": { "kind": "rectangle", "bounds": { "x": 0, "y": 0, "w": 100, "h": 60 } } },
    { "execute": "element.create", "args": { "kind": "ellipse", "bounds": { "x": 200, "y": 0, "w": 100, "h": 60 } } },
    { "execute": "element.lock", "args": { "ids": ["e2"] } },
    { "execute": "doc.clear", "expect": [ { "path": "$.removed", "eq": 2 }, { "path": "$.deleted", "len": 2 }, { "path": "$.undo_label", "eq": "Clear document" } ], "note": "The locked ellipse goes too." },
    { "assert": "doc.inspect", "expect": [ { "path": "$.elements", "eq": 0 } ] },
    { "undo": 1 },
    { "assert": "doc.inspect", "expect": [ { "path": "$.elements", "eq": 2 }, { "path": "$.locked", "eq": 1, "note": "One undo step brings back both elements, and the lock." } ] },

    { "execute": "doc.new", "refused": "unsaved_changes", "text": "This document has unsaved changes. Save it with `doc.save`, or pass on_unsaved=\"discard\" to drop them, or on_unsaved=\"save\" to save and continue." },
    { "execute": "doc.new", "args": { "on_unsaved": "save" }, "refused": "no_save_target", "text": "This document has no save location yet. Pass `to`" },
    { "execute": "doc.new", "args": { "on_unsaved": "discard", "name": "Fresh" }, "expect": [ { "path": "$.elements", "eq": 0 }, { "path": "$.format", "eq": "blank" }, { "path": "$.name", "eq": "Fresh" } ] },
    { "assert": "history.state", "expect": [ { "path": "$.can_undo", "eq": false, "note": "A new document starts without history." } ] },
    { "assert": "engine.state", "expect": [ { "path": "$.dirty", "eq": false, "note": "A blank document is not dirty." } ] },
    { "undo": 1, "refused": "nothing_to_undo" },
    { "execute": "element.create", "args": { "kind": "rectangle", "bounds": { "x": 0, "y": 0, "w": 100, "h": 60 } } },
    { "execute": "doc.new", "args": { "in_new_tab": true, "name": "Second" }, "expect": [ { "path": "$.mode", "eq": "new_tab" }, { "path": "$.tab", "eq": "t2" }, { "path": "$.name", "eq": "Second" } ], "note": "A new tab does not ask about the unsaved work of the tab it leaves." },
    { "assert": "doc.inspect", "expect": [ { "path": "$.elements", "eq": 0 } ] }
  ]
}
