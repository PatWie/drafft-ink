{
  "about": "The old app's Loro snapshot crdt/images.loro opens through doc.open as a clean, history-free document with the same elements, kinds and groups as the JSON document it was built from (images.json); the io fixture check proves the two equal, this proves the command path.",
  "steps": [
    {
      "note": "Numbers are those of legacy_images_loads.json: the snapshot was written from images.json (crdt/images.facts.json, built_from). The old CRDT lost only the closed flag of lines and freehand strokes, which no count here depends on.",
      "harness": "stage_fixture",
      "args": {
        "path": "legacy/crdt/images.loro"
      }
    },
    {
      "execute": "doc.open",
      "args": {
        "source": {
          "path": "fixtures/legacy/crdt/images.loro"
        }
      },
      "expect": [
        {
          "path": "$.elements",
          "eq": 7
        },
        {
          "path": "$.format",
          "eq": "drafftink"
        },
        {
          "path": "$.mode",
          "eq": "replace"
        },
        {
          "path": "$.name",
          "eq": "images"
        },
        {
          "path": "$.warnings",
          "len": 0
        }
      ]
    },
    {
      "assert": "doc.inspect",
      "expect": [
        {
          "path": "$.elements",
          "eq": 7
        },
        {
          "path": "$.kinds",
          "eq": {
            "image": 7
          }
        },
        {
          "path": "$.groups",
          "eq": 0
        }
      ],
      "save": {
        "bx": "$.bounds.x",
        "by": "$.bounds.y",
        "bw": "$.bounds.w",
        "bh": "$.bounds.h"
      },
      "note": "doc.inspect summary: element count, count per kind and group count."
    },
    {
      "assert": "engine.state",
      "expect": [
        {
          "path": "$.dirty",
          "eq": false
        },
        {
          "path": "$.selection.count",
          "eq": 0
        }
      ]
    },
    {
      "assert": "history.state",
      "expect": [
        {
          "path": "$.can_undo",
          "eq": false
        }
      ]
    },
    {
      "assert": "view.get",
      "expect": [
        {
          "path": "$.visible.x",
          "le": "{{bx}}"
        },
        {
          "path": "$.visible.y",
          "le": "{{by}}"
        },
        {
          "path": "$.visible.w",
          "ge": "{{bw}}"
        },
        {
          "path": "$.visible.h",
          "ge": "{{bh}}"
        }
      ],
      "note": "doc.open fits the camera to the content."
    }
  ]
}
