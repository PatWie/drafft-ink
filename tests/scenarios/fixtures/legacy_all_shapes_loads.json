{
  "about": "The old app's document all_shapes.json opens as a clean, history-free document whose element counts per kind and group count equal the facts the old code wrote.",
  "steps": [
    {
      "note": "Numbers are tests/fixtures/legacy/all_shapes.json's facts file (all_shapes.facts.json), doc.counts_total. The old code counted its 1 group(s) as shapes (12 in all); the new model has 11 elements and keeps groups as ids.",
      "harness": "stage_fixture",
      "args": {
        "path": "legacy/all_shapes.json"
      }
    },
    {
      "execute": "doc.open",
      "args": {
        "source": {
          "path": "fixtures/legacy/all_shapes.json"
        }
      },
      "expect": [
        {
          "path": "$.elements",
          "eq": 11
        },
        {
          "path": "$.format",
          "eq": "drafftink"
        },
        {
          "path": "$.mode",
          "eq": "replace"
        },
        {
          "path": "$.warnings",
          "len": 0
        }
      ]
    },
    {
      "expect": [
        {
          "path": "$.elements",
          "eq": 11
        },
        {
          "path": "$.kinds",
          "eq": {
            "arrow": 1,
            "ellipse": 2,
            "freehand": 1,
            "image": 1,
            "line": 1,
            "math": 1,
            "rectangle": 2,
            "text": 2
          }
        },
        {
          "path": "$.groups",
          "eq": 1
        }
      ],
      "assert": "doc.inspect",
      "note": "doc.inspect summary: element count, count per kind and group count.",
      "save": {
        "bx": "$.bounds.x",
        "by": "$.bounds.y",
        "bw": "$.bounds.w",
        "bh": "$.bounds.h"
      }
    },
    {
      "assert": "engine.state",
      "expect": [
        {
          "path": "$.dirty",
          "eq": false
        },
        {
          "path": "$.selection.count",
          "eq": 0
        }
      ]
    },
    {
      "assert": "history.state",
      "expect": [
        {
          "path": "$.can_undo",
          "eq": false
        }
      ]
    },
    {
      "assert": "view.get",
      "expect": [
        {
          "path": "$.visible.x",
          "le": "{{bx}}"
        },
        {
          "path": "$.visible.y",
          "le": "{{by}}"
        },
        {
          "path": "$.visible.w",
          "ge": "{{bw}}"
        },
        {
          "path": "$.visible.h",
          "ge": "{{bh}}"
        }
      ],
      "note": "doc.open fits the camera to the content: the visible world rectangle covers the whole document."
    }
  ]
}
