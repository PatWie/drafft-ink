{
  "about": "The old app's document large_1000.json.gz opens as a clean, history-free document whose element counts per kind and group count equal the facts the old code wrote.",
  "steps": [
    {
      "note": "Numbers are tests/fixtures/legacy/large_1000.json.gz's facts file (large_1000.facts.json.gz), doc.counts_total. The old code counted its 24 group(s) as shapes (1075 in all); the new model has 1051 elements and keeps groups as ids.",
      "harness": "stage_fixture",
      "args": {
        "path": "legacy/large_1000.json.gz"
      }
    },
    {
      "execute": "doc.open",
      "args": {
        "source": {
          "path": "fixtures/legacy/large_1000.json.gz"
        }
      },
      "expect": [
        {
          "path": "$.elements",
          "eq": 1051
        },
        {
          "path": "$.format",
          "eq": "drafftink"
        },
        {
          "path": "$.mode",
          "eq": "replace"
        },
        {
          "path": "$.warnings",
          "len": 0
        }
      ]
    },
    {
      "expect": [
        {
          "path": "$.elements",
          "eq": 1051
        },
        {
          "path": "$.kinds",
          "eq": {
            "arrow": 92,
            "ellipse": 158,
            "freehand": 92,
            "line": 86,
            "math": 13,
            "rectangle": 418,
            "text": 192
          }
        },
        {
          "path": "$.groups",
          "eq": 24
        }
      ],
      "assert": "doc.inspect",
      "note": "doc.inspect summary: element count, count per kind and group count.",
      "save": {
        "bx": "$.bounds.x",
        "by": "$.bounds.y",
        "bw": "$.bounds.w",
        "bh": "$.bounds.h"
      }
    },
    {
      "assert": "engine.state",
      "expect": [
        {
          "path": "$.dirty",
          "eq": false
        },
        {
          "path": "$.selection.count",
          "eq": 0
        }
      ]
    },
    {
      "assert": "history.state",
      "expect": [
        {
          "path": "$.can_undo",
          "eq": false
        }
      ]
    }
  ]
}
