{
  "about": "The old app's document groups_nested.json opens as a clean, history-free document whose element counts per kind and group count equal the facts the old code wrote.",
  "steps": [
    {
      "note": "Numbers are tests/fixtures/legacy/groups_nested.json's facts file (groups_nested.facts.json), doc.counts_total. The old code counted its 11 group(s) as shapes (35 in all); the new model has 24 elements and keeps groups as ids. 2 of the old groups have fewer than two members; the new model derives those as no group, so 9 groups remain.",
      "harness": "stage_fixture",
      "args": {
        "path": "legacy/groups_nested.json"
      }
    },
    {
      "execute": "doc.open",
      "args": {
        "source": {
          "path": "fixtures/legacy/groups_nested.json"
        }
      },
      "expect": [
        {
          "path": "$.elements",
          "eq": 24
        },
        {
          "path": "$.format",
          "eq": "drafftink"
        },
        {
          "path": "$.mode",
          "eq": "replace"
        },
        {
          "path": "$.warnings",
          "len": 0
        }
      ]
    },
    {
      "expect": [
        {
          "path": "$.elements",
          "eq": 24
        },
        {
          "path": "$.kinds",
          "eq": {
            "arrow": 2,
            "ellipse": 5,
            "freehand": 1,
            "image": 1,
            "line": 1,
            "math": 1,
            "rectangle": 8,
            "text": 5
          }
        },
        {
          "path": "$.groups",
          "eq": 9
        }
      ],
      "assert": "doc.inspect",
      "note": "doc.inspect summary: element count, count per kind and group count.",
      "save": {
        "bx": "$.bounds.x",
        "by": "$.bounds.y",
        "bw": "$.bounds.w",
        "bh": "$.bounds.h"
      }
    },
    {
      "assert": "engine.state",
      "expect": [
        {
          "path": "$.dirty",
          "eq": false
        },
        {
          "path": "$.selection.count",
          "eq": 0
        }
      ]
    },
    {
      "assert": "history.state",
      "expect": [
        {
          "path": "$.can_undo",
          "eq": false
        }
      ]
    },
    {
      "assert": "view.get",
      "expect": [
        {
          "path": "$.visible.x",
          "le": "{{bx}}"
        },
        {
          "path": "$.visible.y",
          "le": "{{by}}"
        },
        {
          "path": "$.visible.w",
          "ge": "{{bw}}"
        },
        {
          "path": "$.visible.h",
          "ge": "{{bh}}"
        }
      ],
      "note": "doc.open fits the camera to the content: the visible world rectangle covers the whole document."
    }
  ]
}
