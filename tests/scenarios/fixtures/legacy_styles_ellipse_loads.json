{
  "about": "The old app's document styles_ellipse.json opens as a clean, history-free document whose element counts per kind and group count equal the facts the old code wrote.",
  "steps": [
    {
      "note": "Numbers are tests/fixtures/legacy/styles_ellipse.json's facts file (styles_ellipse.facts.json), doc.counts_total. The old code counted its 0 group(s) as shapes (34 in all); the new model has 34 elements and keeps groups as ids.",
      "harness": "load_fixture",
      "args": {
        "path": "legacy/styles_ellipse.json"
      },
      "expect": [
        {
          "path": "$.elements",
          "eq": 34
        },
        {
          "path": "$.format",
          "eq": "LegacyJson"
        },
        {
          "path": "$.warnings",
          "len": 0
        }
      ]
    },
    {
      "expect": [
        {
          "path": "$.elements",
          "eq": 34
        },
        {
          "path": "$.kinds",
          "eq": {
            "ellipse": 34
          }
        },
        {
          "path": "$.groups",
          "eq": 0
        }
      ],
      "assert": "doc.inspect",
      "note": "doc.inspect summary: element count, count per kind and group count."
    },
    {
      "assert": "engine.state",
      "expect": [
        {
          "path": "$.dirty",
          "eq": false
        },
        {
          "path": "$.selection.count",
          "eq": 0
        }
      ]
    },
    {
      "assert": "history.state",
      "expect": [
        {
          "path": "$.can_undo",
          "eq": false
        }
      ]
    },
    {
      "execute": "view.zoom_to_fit",
      "expect": [
        {
          "path": "$.changed",
          "eq": true
        }
      ]
    },
    {
      "assert": "view.get",
      "expect": [
        {
          "path": "$.visible.w",
          "gt": 0
        }
      ]
    }
  ]
}