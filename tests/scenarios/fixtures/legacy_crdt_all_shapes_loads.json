{
  "about": "The old app's Loro snapshot crdt/all_shapes.loro opens through doc.open as a clean, history-free document with the same elements, kinds and groups as the JSON document it was built from (all_shapes.json); the io fixture check proves the two equal, this proves the command path.",
  "steps": [
    {
      "note": "Numbers are those of legacy_all_shapes_loads.json: the snapshot was written from all_shapes.json (crdt/all_shapes.facts.json, built_from). The old CRDT lost only the closed flag of lines and freehand strokes, which no count here depends on.",
      "harness": "stage_fixture",
      "args": {
        "path": "legacy/crdt/all_shapes.loro"
      }
    },
    {
      "execute": "doc.open",
      "args": {
        "source": {
          "path": "fixtures/legacy/crdt/all_shapes.loro"
        }
      },
      "expect": [
        {
          "path": "$.elements",
          "eq": 11
        },
        {
          "path": "$.format",
          "eq": "drafftink"
        },
        {
          "path": "$.mode",
          "eq": "replace"
        },
        {
          "path": "$.name",
          "eq": "all_shapes"
        },
        {
          "path": "$.warnings",
          "len": 0
        }
      ]
    },
    {
      "assert": "doc.inspect",
      "expect": [
        {
          "path": "$.elements",
          "eq": 11
        },
        {
          "path": "$.kinds",
          "eq": {
            "arrow": 1,
            "ellipse": 2,
            "freehand": 1,
            "image": 1,
            "line": 1,
            "math": 1,
            "rectangle": 2,
            "text": 2
          }
        },
        {
          "path": "$.groups",
          "eq": 1
        }
      ],
      "save": {
        "bx": "$.bounds.x",
        "by": "$.bounds.y",
        "bw": "$.bounds.w",
        "bh": "$.bounds.h"
      },
      "note": "doc.inspect summary: element count, count per kind and group count."
    },
    {
      "assert": "engine.state",
      "expect": [
        {
          "path": "$.dirty",
          "eq": false
        },
        {
          "path": "$.selection.count",
          "eq": 0
        }
      ]
    },
    {
      "assert": "history.state",
      "expect": [
        {
          "path": "$.can_undo",
          "eq": false
        }
      ]
    },
    {
      "assert": "view.get",
      "expect": [
        {
          "path": "$.visible.x",
          "le": "{{bx}}"
        },
        {
          "path": "$.visible.y",
          "le": "{{by}}"
        },
        {
          "path": "$.visible.w",
          "ge": "{{bw}}"
        },
        {
          "path": "$.visible.h",
          "ge": "{{bh}}"
        }
      ],
      "note": "doc.open fits the camera to the content."
    }
  ]
}
