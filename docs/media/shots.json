{
  "shots": [
    {
      "name": "screenshot-light",
      "kind": "window",
      "size": [1280, 800],
      "scale": 1.25,
      "theme": "light",
      "steps": [
        { "id": "selection.select", "args": { "ids": ["@box"] } }
      ]
    },
    {
      "name": "screenshot-dark",
      "kind": "window",
      "size": [1280, 800],
      "scale": 1.25,
      "theme": "dark",
      "steps": [
        { "id": "selection.select", "args": { "ids": ["@box"] } }
      ]
    },
    {
      "name": "screenshot-phone",
      "kind": "window",
      "size": [390, 844],
      "scale": 2.0,
      "theme": "light",
      "touch": true,
      "steps": [
        { "id": "view.zoom_to_fit", "args": { "scope": "ids", "ids": ["@box", "@follower"], "padding": 72 } },
        { "id": "selection.select", "args": { "ids": ["@box"] } }
      ]
    },
    {
      "name": "canvas-only",
      "kind": "export",
      "width": 1600,
      "padding": 40,
      "theme": "light",
      "frame": "@home"
    }
  ]
}
