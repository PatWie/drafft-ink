#!/bin/sh
# AppImage entry point (installed by scripts/package-linux.sh).
# Starts the desktop app with the arguments it was given, so the AppImage is `drafftink` and an MCP client can use
# it as its command:
#   ./drafftink-<version>-linux-x86_64.AppImage mcp
APPDIR="$(dirname "$(readlink -f "$0")")"
exec "$APPDIR/usr/bin/drafftink" "$@"
